# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Smart Union Parishad"

# MongoDB
MONGODB_URI=mongodb://localhost:27017/smart_union_db
# For Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/smart_union_db

# JWT — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64_different
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Security
BCRYPT_SALT_ROUNDS=12

# Initial Super Admin (used by seed script only — change after first run)
SEED_SUPER_ADMIN_EMAIL=admin@smartunion.gov.bd
SEED_SUPER_ADMIN_PASSWORD=CHANGE_ME_strong_password
SEED_SUPER_ADMIN_NAME=System Administrator
